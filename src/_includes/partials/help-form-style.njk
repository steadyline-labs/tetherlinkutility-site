{#- Styles for the /help page (src/help.njk) and its form (partials/help-form.njk).
    Included inside the <style> block after site-chrome-style.njk and read-base-style.njk. -#}
    .help-intro { color: var(--muted); margin-bottom: 28px; }
    .help-form { display: flex; flex-direction: column; gap: 22px; position: relative; min-width: 0; }
    .help-form[hidden], .help-done[hidden], .help-group[hidden], .help-opt[hidden] { display: none; }
    .help-group { border: 0; min-width: 0; }
    .help-group legend, .help-field label { font-size: 16px; font-weight: 700; margin-bottom: 10px; padding: 0; }
    .help-opts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .help-opt {
      display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 10px 14px;
      border: 1px solid var(--border-md); border-radius: 12px; background: var(--surface);
      font-size: 15px; line-height: 1.35; cursor: pointer;
    }
    .help-opt:hover { border-color: var(--accent); }
    .help-opt:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
    .help-opt input { width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--accent-btn); margin: 0; }
    .help-opt span { min-width: 0; overflow-wrap: anywhere; }
    .help-field { display: flex; flex-direction: column; position: relative; }
    .help-field label { display: block; }
    .help-field textarea, .help-field input {
      width: 100%; font: inherit; font-size: 16px; color: var(--text); background: var(--ground);
      border: 1px solid var(--border-md); border-radius: 12px; padding: 12px 14px;
    }
    .help-field textarea { resize: vertical; min-height: 104px; }
    .help-field textarea:focus, .help-field input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
    .help-opt:has(input:focus-visible), .help-send:focus-visible { outline: 2px solid var(--accent-btn); outline-offset: 2px; }
    .help-count { align-self: flex-end; font-size: 13px; color: var(--dim); margin-top: 6px; }
    .help-hp { position: absolute; top: 0; left: 0; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; opacity: 0; pointer-events: none; }
    .help-send {
      align-self: flex-start; border: 0; font: inherit; font-weight: 700; font-size: 16px; min-height: 48px; cursor: pointer;
      background: var(--accent-btn); color: #fff; padding: 13px 32px; border-radius: 12px;
      box-shadow: 0 6px 16px -6px rgba(196,80,31,0.6); transition: background-color 0.15s;
    }
    .help-send:hover { background: var(--accent-btn-hover); }
    .help-send:disabled { opacity: 0.7; cursor: progress; }
    .help-status { font-size: 15px; font-weight: 600; color: var(--accent-text); }
    .help-status:empty { display: none; }
    main .help-note { font-size: 13px; line-height: 1.6; color: var(--dim); margin-bottom: 0; }
    .help-done p { font-size: 17px; font-weight: 600; color: var(--success-text); }
    .help-done:focus { outline: none; }
    .help-video { margin: -8px 0 20px; font-size: 15px; font-weight: 600; }
    .help-video[hidden], .help-video a[hidden] { display: none; }
    @media (max-width: 640px) {
      .help-opts { grid-template-columns: 1fr; }
    }
