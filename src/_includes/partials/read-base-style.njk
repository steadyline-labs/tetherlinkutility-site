{#- Light reading layout shared by blog posts, blog index pages and the privacy page:
    cream page, white ~720px column, navy text, orange only for links and accents.
    Included inside the <style> block after partials/site-chrome-style.njk. -#}
    main {
      max-width: 720px; margin: clamp(24px, 4vw, 48px) auto clamp(48px, 7vw, 88px);
      padding: clamp(40px, 6vw, 64px) clamp(20px, 5vw, 56px) clamp(48px, 6vw, 64px);
      background: var(--surface); border: 1px solid var(--border); border-radius: 24px;
      box-shadow: var(--shadow-sm);
      overflow-wrap: break-word;
    }
    .page-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-text); margin-bottom: 12px; }
    main h1 { font-size: clamp(30px, 4.5vw, 40px); font-weight: 800; letter-spacing: -0.025em; margin-bottom: 8px; line-height: 1.18; text-wrap: balance; }
    main h2 { font-size: 22px; font-weight: 800; letter-spacing: -0.01em; line-height: 1.3; margin: 40px 0 12px; }
    @media (min-width: 641px) { main h2 { font-size: 24px; } }
    main p { color: var(--text); font-size: 17px; line-height: 1.65; margin-bottom: 16px; }
    main ul, main ol { color: var(--text); font-size: 17px; line-height: 1.65; padding-left: 22px; margin-bottom: 16px; }
    main li { margin-bottom: 8px; }
    main li::marker { color: var(--accent); }
    main strong { color: var(--text); font-weight: 700; }
    main a { color: var(--accent-text); text-decoration: underline; text-decoration-color: rgba(180,68,26,0.35); text-underline-offset: 3px; }
    main a:hover { text-decoration-color: currentColor; }
    main code { font-family: ui-monospace, "SF Mono", "Cascadia Code", "Fira Code", monospace; font-size: 0.88em; background: var(--elevated); border: 1px solid var(--border); border-radius: 6px; padding: 1px 6px; }
    main pre { max-width: 100%; overflow-x: auto; }
    main pre, main pre code { color: var(--text) !important; }
    main pre code { background: none; border: none; padding: 0; font-size: inherit; }
    main img, main video { max-width: 100%; height: auto; }
    @media (max-width: 640px) {
      main { margin: 0 0 40px; padding: 32px 20px 40px; border: 0; border-radius: 0; box-shadow: none; background: transparent; }
      main p, main ul, main ol { font-size: 16px; }
    }
