{#- Navy site footer, shared by the home, blog and privacy pages. Needs `t`, `lang` and `blogPrefix`.
    Three bands: help, then site links and languages, then (below a hairline) the owner line. -#}
<footer class="wrap">
  <div class="footer-help">
    <a class="footer-lead" href="{{ t.prefix }}help.html">{{ t.help.link }}</a>
    <a class="footer-accent" href="mailto:{{ site.email }}">{{ site.email }}</a>
    <a class="footer-accent" href="{{ site.whatsapp }}" target="_blank" rel="noopener"><svg class="wa-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.95L2 22l5.2-1.5A9.9 9.9 0 1 0 12.04 2zm0 1.8a8.1 8.1 0 1 1-4.3 14.96l-.3-.2-3 .87.9-2.9-.2-.3A8.1 8.1 0 0 1 12.04 3.8zm-3.3 4.1c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.2 4.9 4.4 2.4 1 2.9.8 3.4.7.5 0 1.7-.7 1.9-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.4-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.400-.8-.8-1.400-1.7-1.500-2-.2-.3 0-.4.1-.6l.4-.5c.1-.1.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.200c-.2-.5-.5-.5-.7-.5z"/></svg>{{ t.help.whatsapp }}</a>
  </div>
  <div class="footer-links" role="navigation" aria-label="Footer">
    <a href="{{ blogPrefix }}blog/">{{ t.blog }}</a>
{% if not hidePrivacyLink %}    <a href="{{ t.privacyHref }}">{{ t.privacy }}</a>
{% endif %}    <a class="footer-x" href="https://x.com/steadylinelabs_" target="_blank" rel="noopener" aria-label="Follow on X"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
  </div>
  <div class="footer-langs" role="navigation" aria-label="Languages">
{% for l in site.languages %}{% if l != lang %}    <a href="{{ i18n[l].prefix }}" hreflang="{{ l }}" lang="{{ l }}">{{ i18n[l].name }}</a>
{% else %}    <span class="is-current" aria-current="page" lang="{{ l }}">{{ i18n[l].name }}</span>
{% endif %}{% endfor %}  </div>
  <div class="footer-brand"><span>&copy; 2026 Tether Link Utility</span><span>{{ t.publisherPrefix }}<a href="{{ site.publisherUrl }}">Steadyline Labs</a></span></div>
</footer>
