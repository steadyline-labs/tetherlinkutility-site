{#- Navy site footer, shared by the home, blog and privacy pages. Needs `t`, `lang` and `blogPrefix`. -#}
<footer class="wrap">
  <div class="footer-brand"><span>&copy; 2026 Tether Link Utility</span><span class="sep" aria-hidden="true">&middot;</span><span>{{ t.publisherPrefix }}<a href="{{ site.publisherUrl }}">Steadyline Labs</a></span><span class="sep" aria-hidden="true">&middot;</span><span><a href="mailto:{{ site.email }}">{{ site.email }}</a></span></div>
  <div class="footer-links">
    <a href="{{ t.prefix }}#help">{{ t.help.link }}</a>
    <a href="{{ blogPrefix }}blog/">{{ t.blog }}</a>
{% if not hidePrivacyLink %}    <a href="{{ t.privacyHref }}">{{ t.privacy }}</a>
{% endif %}{% for l in site.languages %}{% if l != lang %}    <a href="{{ i18n[l].prefix }}">{{ i18n[l].name }}</a>
{% endif %}{% endfor %}    <a href="https://x.com/tetherlinkutili" target="_blank" rel="noopener" aria-label="Follow on X" style="display:inline-flex; align-items:center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
  </div>
</footer>
