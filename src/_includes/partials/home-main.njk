{#- Homepage body (hero, how it works, demo, platforms, pricing, guides, FAQ).
    All page text comes from src/_data/home/<lang>.json; the markup is shared by every language.
    FAQ: the first `faq.visible` questions are shown, the rest go inside the "show more" block. -#}
{%- set h = home[lang] %}
  <section class="hero wrap">
    <div class="hero-content">
      <div class="hero-pills"><span class="pill pill-accent">Android</span><span class="pill pill-accent"><span class="keep-case">iOS</span></span></div>
      <h1><span class="hero-brand">{{ site.name }}</span>{{ h.hero.h1 }}<span>{{ h.hero.h1Accent }}</span></h1>
      <p class="hero-body">{{ h.hero.body }}</p>
      <div class="hero-actions">
        <a href="{{ page.url | playLink(lang) }}" class="play-badge" aria-label="{{ h.hero.playLabel }}">
          <svg width="30" height="30" viewBox="0 0 24 24">
            <defs>
              <linearGradient id="pbBlue" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#00D8FF"/><stop offset="100%" stop-color="#0084FF"/>
              </linearGradient>
              <linearGradient id="pbGreen" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#5AE560"/><stop offset="100%" stop-color="#00C24C"/>
              </linearGradient>
              <linearGradient id="pbYellow" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FFE000"/><stop offset="100%" stop-color="#FFB000"/>
              </linearGradient>
              <linearGradient id="pbRed" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FF6B6B"/><stop offset="100%" stop-color="#E8422E"/>
              </linearGradient>
            </defs>
            <path d="M3.18 23.76c.3.17.64.24.99.19L15.89 12 3.18.05C2.83 0 2.48.07 2.18.24 1.59.57 1.2 1.22 1.2 2v20c0 .78.39 1.43.98 1.76z" fill="url(#pbBlue)"/>
            <path d="M4.14 1.37l12.22 7.07-3.27 3.27L4.14 1.37z" fill="url(#pbGreen)"/>
            <path d="M4.14 22.63l8.95-8.95 3.27 3.27-12.22 5.68z" fill="url(#pbRed)"/>
            <path d="M19.62 9.29l-2.94-1.7-3.27 3.27 3.27 3.27 2.97-1.72c.85-.49.85-1.63-.03-2.12z" fill="url(#pbYellow)"/>
          </svg>
          <span class="pb-text"><span class="pb-eyebrow">{{ h.hero.playEyebrow }}</span><span class="pb-word">{{ h.hero.playWord }}</span></span>
        </a>
        <a href="{{ site.appStoreUrl }}" class="appstore-badge" aria-label="{{ h.hero.iosLabel }}"><img src="/assets/badges/app-store-{{ lang }}.svg" alt="{{ h.hero.iosLabel }}" height="54" width="162"></a>
      </div>
      <ul class="hero-trust">
{% for item in h.hero.trust %}        <li>{{ item }}</li>
{% if loop.first %}        <li>{{ h.hero.trustNoRoot }}</li>
{% endif %}{% endfor %}      </ul>
    </div>
    <div class="hero-visual">
      <div class="hv-card">
        <div class="hv-top" aria-hidden="true"><span class="hv-live"></span><span class="hv-wifi">Wi-Fi</span><span class="hv-port">SOCKS5 &middot; 8282</span></div>
        {#- Phone (real app screenshot) feeding three connected devices. Only the screenshot is
            exposed to screen readers (its alt text); the rest is decorative and aria-hidden. -#}
        <div class="hv-stage">
          <div class="hv-phone"><div class="hv-screen"><img src="{{ h.hero.screenshot }}" alt="{{ h.hero.screenshotAlt }}" width="1080" height="2400" fetchpriority="high" /></div></div>
          <div class="hv-links" aria-hidden="true"><svg viewBox="0 0 100 300" preserveAspectRatio="none" focusable="false">
            <g class="hv-links-base"><path d="M0 150C50 150 50 50 100 50"/><path d="M0 150H100"/><path d="M0 150C50 150 50 250 100 250"/></g>
            <g class="hv-links-flow"><path d="M0 150C50 150 50 50 100 50"/><path d="M0 150H100"/><path d="M0 150C50 150 50 250 100 250"/></g>
          </svg></div>
          <div class="hv-devices" aria-hidden="true">
            <div class="hv-dev"><span class="hv-dev-art">
              <svg class="hv-laptop" viewBox="0 0 120 80" focusable="false"><rect x="14" y="4" width="92" height="60" rx="6" fill="#1A1A2E"/><rect x="19" y="9" width="82" height="50" rx="2" fill="#FFF4EA"/><rect x="19" y="9" width="82" height="8" fill="#FFE0CC"/><circle cx="24.5" cy="13" r="1.7" fill="#E8622A"/><circle cx="30" cy="13" r="1.7" fill="#E3D3C2"/><rect x="27" y="23" width="44" height="6" rx="3" fill="#1A1A2E"/><rect x="27" y="33" width="64" height="3.5" rx="1.75" fill="#55536B" opacity=".45"/><rect x="27" y="40" width="56" height="3.5" rx="1.75" fill="#55536B" opacity=".45"/><rect x="27" y="48" width="22" height="6" rx="3" fill="#E8622A"/><path d="M3 66h114l-5 8H8z" fill="#D9CABB"/><rect x="50" y="66" width="20" height="3" rx="1.5" fill="#B9A796"/></svg>
              <span class="hv-ok"></span></span></div>
            <div class="hv-dev"><span class="hv-dev-art">
              <svg class="hv-tablet" viewBox="0 0 80 100" focusable="false"><rect x="4" y="2" width="72" height="96" rx="9" fill="#1A1A2E"/><rect x="9" y="7" width="62" height="86" rx="4" fill="#FFF4EA"/><rect x="14" y="13" width="52" height="30" rx="4" fill="#E8622A"/><path d="M36 22l10 6-10 6z" fill="#fff"/><rect x="14" y="50" width="40" height="5" rx="2.5" fill="#1A1A2E"/><rect x="14" y="60" width="52" height="3.5" rx="1.75" fill="#55536B" opacity=".45"/><rect x="14" y="67" width="46" height="3.5" rx="1.75" fill="#55536B" opacity=".45"/><rect x="14" y="74" width="50" height="3.5" rx="1.75" fill="#55536B" opacity=".45"/></svg>
              <span class="hv-ok"></span></span></div>
            <div class="hv-dev"><span class="hv-dev-art">
              <svg class="hv-mobile" viewBox="0 0 52 100" focusable="false"><rect x="6" y="2" width="40" height="96" rx="9" fill="#1A1A2E"/><rect x="9.5" y="7" width="33" height="86" rx="5" fill="#FFF4EA"/><rect x="20" y="9.5" width="12" height="3" rx="1.5" fill="#1A1A2E"/><rect x="13" y="20" width="22" height="9" rx="4.5" fill="#E3D3C2"/><rect x="18" y="33" width="21" height="9" rx="4.5" fill="#E8622A"/><rect x="13" y="46" width="18" height="9" rx="4.5" fill="#E3D3C2"/><rect x="16" y="59" width="23" height="9" rx="4.5" fill="#E8622A"/><rect x="13" y="80" width="26" height="6" rx="3" fill="#FFE0CC"/></svg>
              <span class="hv-ok"></span></span></div>
          </div>
          <div class="hv-label hv-label-host" aria-hidden="true"><span class="hv-bars"><i></i><i></i><i></i><i></i></span>{{ h.hero.visual.host }}</div>
          <div class="hv-label hv-label-devices" aria-hidden="true">{{ h.hero.visual.devices }}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap" id="how">
    <span class="anchor-alias" id="why"></span>
    <div class="section-head">
      <h2>{{ h.how.title }}</h2>
      <a class="demo-link" href="#demo">{{ h.how.demoLink }}</a>
    </div>
    <div class="before" aria-labelledby="before-title">
      <h3 class="before-title" id="before-title">{{ h.how.before.title }}</h3>
      <p class="before-lead">{{ h.how.before.lead }}</p>
      <div class="roles">
{% for r in h.how.before.roles %}        <div class="role role-{{ r.kind }}">
          <span class="role-tag">{{ r.tag }}</span>
          <h4>{{ r.title }}</h4>
{% for l in r.lines %}          <p>{{ l | safe }}</p>
{% endfor %}        </div>
{% if loop.first %}        <span class="roles-arrow" aria-hidden="true"></span>
{% endif %}{% endfor %}      </div>
      <p class="before-help">{{ h.how.before.help | safe }}</p>
    </div>
    <ol class="steps">
{% for step in h.how.steps %}      <li class="step">
        <div class="step-num">0{{ loop.index }}</div>
        <h3>{{ step.title }}</h3>
        <p>{{ step.text }}</p>
      </li>
{% endfor %}    </ol>
    <span class="anchor-alias" id="features"></span>
    <div class="cards">
{% for card in h.how.cards %}      <div class="card">
        <h3>{{ card.title }}</h3>
        <p>{{ card.text }}</p>
      </div>
{% endfor %}    </div>
    <p class="notes">{{ h.how.notes }}</p>
  </section>

  <section class="section wrap video-showcase band-peach" id="demo">
    <h2>{{ h.demo.title }}</h2>
    <p class="video-sub">{{ h.demo.subtitle }}</p>
{%- set guideUrl %}{% if collections | hasPost(lang, "socks5-proxy-setup-windows-macos-ios") %}{{ t.prefix }}{% else %}/{% endif %}blog/socks5-proxy-setup-windows-macos-ios.html{% endset %}
{%- set playIcon %}<span class="video-facade-play" aria-hidden="true"><svg width="60" height="60" viewBox="0 0 60 60"><circle cx="30" cy="30" r="30" fill="rgba(0,0,0,0.6)"/><path d="M24 18l20 12-20 12V18z" fill="#fff"/></svg></span>{% endset %}
    <div class="video-grid">
{%- for d in [{ key: "windows", anchor: "windows", title: h.demo.windowsTitle, link: h.demo.windowsLink }, { key: "mac", anchor: "macos", title: h.demo.macTitle, link: h.demo.macLink }] %}{% set v = lang | guideVideo(d.key) %}
      <article class="video-card" aria-labelledby="demo-{{ d.key }}-title">
        <div class="video-facade video-card-cover" data-yt-id="{{ v.id }}" data-yt-title="{{ v.name }}" role="button" tabindex="0" aria-label="{{ t.video.play }}: {{ d.title }}, {{ v.length }}{% if t.video.note %}, {{ t.video.note }}{% endif %}">
          <img src="{{ v.cover }}" alt="" loading="lazy" decoding="async" width="960" height="540" />
          {{ playIcon | safe }}
          <span class="video-badge" aria-hidden="true">{{ v.length }}</span>{% if t.video.note %}
          <span class="video-pill" aria-hidden="true">{{ t.video.note }}</span>{% endif %}
        </div>
        <div class="video-card-body">
          <span class="video-label">{{ h.demo.howLabel }}</span>
          <h3 id="demo-{{ d.key }}-title">{{ d.title }}</h3>
{%- if t.video.note %}
          <p class="video-meta">{{ v.length }} · {{ t.video.note }}</p>{% endif %}
          <a class="video-guide-link" href="{{ guideUrl }}#{{ d.anchor }}">{{ d.link }} <span aria-hidden="true">&rarr;</span></a>
        </div>
      </article>
{%- endfor %}
      <article class="video-card video-card-short" aria-labelledby="demo-short-title">
        <div class="video-facade video-card-cover" data-yt-id="{{ h.demo.videoId }}" data-yt-title="{{ t.homeNav.videoTitle }}" role="button" tabindex="0" aria-label="{{ h.demo.playLabel }}: {{ h.demo.shortTitle }}, {{ videos[h.demo.videoId].length }}{% if t.video.note %}, {{ t.video.note }}{% endif %}">
          <img src="{{ h.demo.cover }}" alt="{{ h.demo.previewAlt }}" loading="lazy" decoding="async" width="720" height="1280" />
          {{ playIcon | safe }}
          <span class="video-badge" aria-hidden="true">{{ videos[h.demo.videoId].length }}</span>
        </div>
        <div class="video-card-body">
          <span class="video-label">{{ h.demo.demoLabel }}</span>
          <h3 id="demo-short-title">{{ h.demo.shortTitle }}</h3>
        </div>
      </article>
    </div>
  </section>

  <section class="section wrap band-navy" id="platforms">
    <div class="platforms-grid">
      <div class="platforms-intro">
        <div class="section-label">{{ h.platforms.label }}</div>
        <h2>{{ h.platforms.title }}</h2>
        <p>{{ h.platforms.text }}</p>
        <a class="demo-link" href="{% if collections | hasPost(lang, "socks5-proxy-setup-windows-macos-ios") %}{{ t.prefix }}{% else %}/{% endif %}blog/socks5-proxy-setup-windows-macos-ios.html">{{ h.platforms.guideLink }}</a>
      </div>
      <ul class="platform-list">
{% for p in h.platforms.items %}        <li class="platform"><span class="mono" aria-hidden="true">{{ p.mono }}</span><div class="platform-info"><h3>{{ p.name }}</h3><p>{{ p.text }}</p></div><span class="code-chip">{{ p.chip }}</span></li>
{% endfor %}      </ul>
    </div>
  </section>

  <section class="section wrap" id="pricing">
    <div class="section-label">{{ h.pricing.label }}</div>
    <h2 style="margin-bottom:32px">{{ h.pricing.title }}</h2>
    <div class="pricing-cards">
{% for plan in h.pricing.plans %}      <div class="price-card{% if plan.pro %} pro{% endif %}">
        <h3>{{ plan.name }}</h3>
        <div class="price">{% if plan.pricePrefix %}<span>{{ plan.pricePrefix }}</span>{% endif %}<b>{{ plan.price }}</b>{% if plan.priceSuffix %}<span>{{ plan.priceSuffix }}</span>{% endif %}</div>
        <ul>
{% for f in plan.features %}          <li>{{ f }}</li>
{% endfor %}        </ul>
      </div>
{% endfor %}    </div>
    <p class="price-note">{{ h.pricing.note }}</p>
  </section>

  {% if collections | hasBlog(lang) %}{% include "partials/home-guides.njk" %}{% endif %}

  <section class="section wrap faq" id="faq">
    <div class="faq-wrap">
    <h2>{{ h.faq.title }}</h2>
{% for item in h.faq.items %}{% if loop.index0 == h.faq.visible %}
    <div class="faq-more" id="faqMore">
{% endif %}
    <details class="faq-item">
      <summary>{{ item.q }}</summary>
      <p>{{ item.a }}</p>
    </details>
{% endfor %}
    </div>
    <button type="button" class="faq-toggle" id="faqToggle" aria-controls="faqMore" aria-expanded="false" data-more="{{ h.faq.more }}" data-less="{{ h.faq.less }}" hidden>{{ h.faq.more }}</button>
    <a class="faq-help" href="{{ t.prefix }}help.html">{{ t.help.link }}</a>
    </div>
  </section>

  <section class="closing wrap">
    <div class="closing-card">
      <div class="closing-text">
        <h2>{{ h.closing.title }}</h2>
        <p>{{ t.homeNav.sticky }}</p>
      </div>
      <a href="{{ page.url | playLink(lang) }}" class="play-badge" aria-label="{{ h.hero.playLabel }}">
        <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3.18 23.76c.3.17.64.24.99.19L15.89 12 3.18.05C2.83 0 2.48.07 2.18.24 1.59.57 1.2 1.22 1.2 2v20c0 .78.39 1.43.98 1.76z" fill="url(#pbBlue)"/>
          <path d="M4.14 1.37l12.22 7.07-3.27 3.27L4.14 1.37z" fill="url(#pbGreen)"/>
          <path d="M4.14 22.63l8.95-8.95 3.27 3.27-12.22 5.68z" fill="url(#pbRed)"/>
          <path d="M19.62 9.29l-2.94-1.7-3.27 3.27 3.27 3.27 2.97-1.72c.85-.49.85-1.63-.03-2.12z" fill="url(#pbYellow)"/>
        </svg>
        <span class="pb-text"><span class="pb-eyebrow">{{ h.hero.playEyebrow }}</span><span class="pb-word">{{ h.hero.playWord }}</span></span>
      </a>
      <a href="{{ site.appStoreUrl }}" class="appstore-badge" aria-label="{{ h.hero.iosLabel }}"><img src="/assets/badges/app-store-{{ lang }}.svg" alt="{{ h.hero.iosLabel }}" height="54" width="162"></a>
    </div>
  </section>
