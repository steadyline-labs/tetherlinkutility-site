<script>
  (function () {
    // FAQ: the first questions stay visible; the rest stay in the DOM (and in the
    // FAQPage JSON-LD) and are collapsed in place. Without JS everything is shown.
    var more = document.getElementById('faqMore');
    var btn = document.getElementById('faqToggle');
    if (!more || !btn) return;
    function setOpen(open) {
      if (open) more.removeAttribute('data-collapsed'); else more.setAttribute('data-collapsed', '');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.innerHTML = open ? btn.getAttribute('data-less') : btn.getAttribute('data-more');
    }
    function openForHash() {
      var id = location.hash.slice(1);
      var t = id && document.getElementById(id);
      if (t && more.contains(t)) setOpen(true);
    }
    setOpen(false);
    btn.hidden = false;
    btn.addEventListener('click', function () { setOpen(more.hasAttribute('data-collapsed')); });
    openForHash();
    window.addEventListener('hashchange', openForHash);
  }());

  (function () {
    // Shows a compact install CTA once the user has scrolled past the hero, and hides
    // it again near the very bottom so it doesn't sit on top of the footer.
    var bar = document.getElementById('stickyCta');
    var hero = document.querySelector('.hero');
    if (!bar || !hero) return;
    window.addEventListener('scroll', function () {
      var pastHero = window.scrollY > hero.offsetTop + hero.offsetHeight;
      var nearBottom = window.scrollY + window.innerHeight > document.body.scrollHeight - 300;
      bar.classList.toggle('is-visible', pastHero && !nearBottom);
    }, { passive: true });
  }());
</script>
