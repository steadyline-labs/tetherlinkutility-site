{#- Site header, shared by the home, blog and privacy pages.
    navMode: unset on the home page (section links are in-page anchors), "blog", "privacy" or "help" elsewhere.
    Needs `blogPrefix` (set by each layout, also used by the footer). -#}
{%- set navBase = t.prefix if navMode else "" -%}
<nav>
  <a class="nav-brand" href="{{ t.prefix }}">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
      <rect width="22" height="22" rx="5" fill="#E8622A"/>
      <g transform="translate(3,3) scale(0.6667)" fill="white">
        <path d="M20.2,5.9l0.8,-0.8C19.6,3.7 17.8,3 16,3s-3.6,0.7 -5,2.1l0.8,0.8C13,4.8 14.5,4.2 16,4.2s3,0.6 4.2,1.7zM19.3,6.7c-0.9,-0.9 -2.1,-1.4 -3.3,-1.4s-2.4,0.5 -3.3,1.4l0.8,0.8c0.7,-0.7 1.6,-1 2.5,-1 0.9,0 1.8,0.3 2.5,1l0.8,-0.8zM19,13h-2L17,9h-2v4L5,13c-1.1,0 -2,0.9 -2,2v4c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2v-4c0,-1.1 -0.9,-2 -2,-2zM8,18L6,18v-2h2v2zM11.5,18h-2v-2h2v2zM15,18h-2v-2h2v2z"/>
      </g>
    </svg>
    Tether Link Utility
  </a>
  <button class="nav-toggle" id="navToggle" aria-label="{{ t.homeNav.openMenu }}" aria-expanded="false" aria-controls="navLinks">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <line x1="3" y1="6" x2="19" y2="6"/>
      <line x1="3" y1="11" x2="19" y2="11"/>
      <line x1="3" y1="16" x2="19" y2="16"/>
    </svg>
  </button>
  <div class="nav-links" id="navLinks">
    <a href="{{ navBase }}#how">{{ t.homeNav.how }}</a>
    <a href="{{ navBase }}#platforms">{{ t.homeNav.platforms }}</a>
    <a href="{{ navBase }}#pricing">{{ t.homeNav.pricing }}</a>
    <a href="{{ navBase }}#faq">{{ t.homeNav.faq }}</a>
    <a href="{{ blogPrefix }}blog/">{{ t.blog }}</a>
    <div class="lang-dropdown" id="langDropdown">
      <button class="lang-dropdown-toggle" id="langDropdownToggle" aria-label="{{ t.homeNav.language }}" aria-haspopup="true" aria-expanded="false" aria-controls="langDropdownMenu">
        <span>{{ t.code }}</span>
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1.5 3.5L5 7l3.5-3.5"/></svg>
      </button>
      <div class="lang-dropdown-menu" id="langDropdownMenu" role="menu">
{#- Home: each language's home. Blog: the same post if it exists there, else that language's blog index,
    else (no blog yet) its home. Privacy: the language's section on the same page. Help: that language's help page. -#}
{% for l in site.languages %}        <a href="{% if navMode == "privacy" %}#{{ l }}{% elif navMode == "help" %}{{ i18n[l].prefix }}help.html{% elif navMode == "blog" %}{{ site.url }}{{ i18n[l].prefix }}{% if slug and (collections | hasPost(l, slug)) %}{{ langPath }}{% elif (collections | hasBlog(l)) or l == lang %}blog/{% endif %}{% else %}{{ i18n[l].prefix }}{% endif %}"{% if l == lang %} class="is-current"{% endif %} role="menuitem">{{ i18n[l].name }}</a>
{% endfor %}      </div>
    </div>
    <a href="{{ site.playUrl }}" class="btn-nav">{{ t.homeNav.getApp }}</a>
  </div>
</nav>