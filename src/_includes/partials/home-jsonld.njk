{#- Homepage JSON-LD blocks. Text comes from src/_data/home/<lang>.json.
    `jsonld` in that file lists the blocks in output order (type: website, organization, howTo,
    app, faq, video); `gap: true` puts an empty line before the block. WebSite and Organization always
    use the site root (Google reads the site name from the domain's home page); `ldUrl` overrides
    the page URL used in the SoftwareApplication block.
    `inLanguage` (optional) adds inLanguage to every block except Organization and VideoObject (es/hi/pt show the
    English video). VideoObject text comes from src/_data/videos.json, keyed by demo.videoId; the Windows
    and Mac how-to videos in the #demo section add one VideoObject each (src/_data/guideVideos.json).
    FAQPage answers are the FAQ answers with HTML tags removed. -#}
{%- set h = home[lang] -%}
{%- set ldUrl = h.ldUrl or (site.url + t.prefix) -%}
{%- for b in h.jsonld %}{% if not loop.first %}
{% if b.gap %}
{% endif %}  {% endif %}<script type="application/ld+json">
  {
    "@context": "https://schema.org",
{% if h.inLanguage and b.type != "organization" and b.type != "video" %}    "inLanguage": "{{ h.inLanguage }}",
{% endif %}{% if b.type == "website" %}    "@type": "WebSite",
    "name": "{{ site.name }}",
    "alternateName": ["TetherLinkUtility", "Tether Link"],
    "url": "{{ site.url }}/"
{% elif b.type == "organization" %}    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}/",
    "logo": "{{ site.url }}/favicon.png",
    "email": "{{ site.email }}",
    "sameAs": [
      "{{ site.playUrl }}",
      "https://www.producthunt.com/products/tether-link-utility",
      "https://www.nxgntools.com/tools/tether-link-utility",
      "https://viberank.dev/apps/Tether%20Link%20Utility"
    ]
{% elif b.type == "howTo" %}    "@type": "HowTo",
    "name": {{ h.howTo.name | dump }},
    "step": [
{% for s in h.howTo.steps %}      {
        "@type": "HowToStep",
        "name": {{ s.name | dump }},
        "text": {{ s.text | dump }}
      }{% if not loop.last %},{% endif %}
{% endfor %}    ]
{% elif b.type == "app" %}    "@type": "SoftwareApplication",
    "name": "{{ site.name }}",
    "publisher": { "@type": "Organization", "name": "Steadyline Labs", "url": "{{ site.publisherUrl }}" },
    "sameAs": ["{{ site.playUrl }}"],
    "installUrl": "{{ site.playUrl }}",
    "downloadUrl": "{{ site.playUrl }}",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Android",
    "url": "{{ ldUrl }}",
    "description": {{ h.app.description | dump }},
    "featureList": [
{% for f in h.app.featureList %}      {{ f | dump }}{% if not loop.last %},{% endif %}
{% endfor %}    ],
    "offers": [
      {
        "@type": "Offer",
        "name": {{ h.app.freeName | dump }},
        "price": "0",
        "priceCurrency": "{{ 'TRY' if lang == 'tr' else 'USD' }}"
      },
      {
        "@type": "Offer",
        "name": "Pro",
        "price": "{{ '109.99' if lang == 'tr' else '3.99' }}",
        "priceCurrency": "{{ 'TRY' if lang == 'tr' else 'USD' }}",
        "description": {{ h.app.proDescription | dump }}
      }
    ]
{% elif b.type == "video" %}{% set v = videos[h.demo.videoId] %}    "@type": "VideoObject",
    "name": {{ v.name | dump }},
    "description": {{ v.description | dump }},
    "thumbnailUrl": ["{{ site.url }}{{ h.demo.cover }}", "https://i.ytimg.com/vi/{{ h.demo.videoId }}/maxresdefault.jpg"],
    "uploadDate": "{{ v.uploadDate }}",
    "duration": "{{ v.duration }}",
    "embedUrl": "https://www.youtube.com/embed/{{ h.demo.videoId }}",
    "url": "https://www.youtube.com/shorts/{{ h.demo.videoId }}"
{% elif b.type == "faq" %}    "@type": "FAQPage",
    "mainEntity": [
{% for item in h.faq.items %}      {
        "@type": "Question",
        "name": {{ item.q | dump }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ (item.a | striptags | replace("&gt;", ">")) | dump }}
        }
      }{% if not loop.last %},{% endif %}
{% endfor %}    ]
{% endif %}  }
  </script>{% endfor %}
{{ lang | guideVideoLd("windows", site.url) | safe }}{{ lang | guideVideoLd("mac", site.url) | safe }}