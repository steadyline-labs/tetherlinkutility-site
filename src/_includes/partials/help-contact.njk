{#- Help contact block on the /help page (src/help.njk). Text comes from i18n[lang].help.
    Nothing is sent from the site: the button opens WhatsApp with a prefilled English greeting
    (site.whatsapp), and the email address is the fallback. -#}
{%- set hp = t.help -%}
      <div class="help-contact">
        <a class="help-wa" href="{{ site.whatsapp }}" target="_blank" rel="noopener"><svg class="wa-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" style="margin-right:10px;flex-shrink:0"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.95L2 22l5.2-1.5A9.9 9.9 0 1 0 12.04 2zm0 1.8a8.1 8.1 0 1 1-4.3 14.96l-.3-.2-3 .87.9-2.9-.2-.3A8.1 8.1 0 0 1 12.04 3.8zm-3.3 4.1c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.2 4.9 4.4 2.4 1 2.9.8 3.4.7.5 0 1.7-.7 1.9-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.4-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.400-.8-.8-1.400-1.7-1.500-2-.2-.3 0-.4.1-.6l.4-.5c.1-.1.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.200c-.2-.5-.5-.5-.7-.5z"/></svg>{{ hp.whatsapp }}</a>
        <p class="help-email">{{ hp.emailFallback }} <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        <p class="help-note">{{ hp.note }} <a href="{{ hp.privacyHref }}">{{ hp.privacyLink }}</a></p>
      </div>
