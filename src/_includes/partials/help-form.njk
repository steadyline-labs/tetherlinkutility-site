{#- "Can't connect?" help request form (anchor #help). Text comes from i18n[lang].help.
    Sends one Firestore REST commit (no SDK): help_rate/<iid> + help_requests/<random id>.
    The rules (Firebase project tether-link-utility) allow one send per browser every 5 minutes.
    Set helpPage ("guide" or "support") before including; it is sent as diag.page. -#}
{%- set hp = t.help -%}
{%- set stepsFor = {
  "android": "start_sharing scan_qr join_wifi no_internet other",
  "ios": "start_sharing install join_wifi ios_proxy_app no_internet other",
  "windows": "start_sharing install join_wifi set_proxy no_internet other",
  "mac": "start_sharing install join_wifi set_proxy no_internet other",
  "linux": "start_sharing install join_wifi set_proxy no_internet other"
} -%}
  <section class="section wrap help" id="help">
    <div class="help-wrap">
      <div class="help-head">
        <h2>{{ hp.title }}</h2>
        <p class="help-intro">{{ hp.intro }}</p>
      </div>
      <form class="help-form" id="helpForm" novalidate data-lang="{{ lang }}" data-page="{{ helpPage or 'guide' }}">
        <fieldset class="help-group" id="helpPlatforms">
          <legend>{{ hp.q1 }}</legend>
          <div class="help-opts">
{% for key, label in hp.platforms %}            <label class="help-opt"><input type="radio" name="platform" value="{{ key }}"><span>{{ label }}</span></label>
{% endfor %}          </div>
        </fieldset>
        <fieldset class="help-group" id="helpSteps" hidden>
          <legend>{{ hp.q2 }}</legend>
          <div class="help-opts">
{% for key, label in hp.steps %}            <label class="help-opt" data-step="{{ key }}"><input type="radio" name="step" value="{{ key }}"><span>{{ label }}</span></label>
{% endfor %}          </div>
        </fieldset>
        <div class="help-field">
          <label for="helpMessage">{{ hp.message }}</label>
          <textarea id="helpMessage" name="message" rows="4" maxlength="500" aria-describedby="helpCount"></textarea>
          <span class="help-count" id="helpCount">0/500</span>
        </div>
        <div class="help-field">
          <label for="helpEmail">{{ hp.email }}</label>
          <input id="helpEmail" name="email" type="email" maxlength="120" autocomplete="email" inputmode="email" spellcheck="false">
        </div>
        <div class="help-hp" aria-hidden="true">
          <label for="helpWebsite">Website</label>
          <input id="helpWebsite" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>
        <button type="submit" class="btn-primary help-send" id="helpSend" data-sending="{{ hp.sending }}">{{ hp.button }}</button>
        <p class="help-status" id="helpStatus" role="status" aria-live="polite"></p>
        <noscript><p class="help-status">{{ hp.noscript }} <a href="mailto:{{ site.email }}">{{ site.email }}</a></p></noscript>
        <p class="help-note">{{ hp.note }} <a href="{{ hp.privacyHref }}">{{ hp.privacyLink }}</a></p>
      </form>
      <div class="help-done" id="helpDone" hidden tabindex="-1">
        <p>{{ hp.success }}</p>
      </div>
    </div>
  </section>
<script>
  (function () {
    var form = document.getElementById('helpForm');
    if (!form) return;
    var ENDPOINT = 'https://firestore.googleapis.com/v1/projects/tether-link-utility/databases/(default)/documents:commit';
    var DOCS = 'projects/tether-link-utility/databases/(default)/documents/';
    var STEPS = {{ stepsFor | dump }};
    var TEXT = {{ { recent: hp.recent, choose: hp.choose, emailBad: hp.emailBad, error: hp.error, email: site.email } | dump }};
    var IID_KEY = 'tlu_help_iid', SENT_KEY = 'tlu_help_sent', FIVE_MIN = 5 * 60 * 1000;

    var stepsBox = document.getElementById('helpSteps');
    var msg = document.getElementById('helpMessage');
    var count = document.getElementById('helpCount');
    var email = document.getElementById('helpEmail');
    var trap = document.getElementById('helpWebsite');
    var btn = document.getElementById('helpSend');
    var status = document.getElementById('helpStatus');
    var done = document.getElementById('helpDone');
    var label = btn.textContent;

    function rnd(n, chars) {
      var out = '', buf = new Uint8Array(n);
      try { crypto.getRandomValues(buf); } catch (e) { for (var j = 0; j < n; j++) buf[j] = Math.floor(Math.random() * 256); }
      for (var i = 0; i < n; i++) out += chars.charAt(buf[i] % chars.length);
      return out;
    }
    var ALNUM = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    function store(key, val) {
      try { if (val === undefined) return localStorage.getItem(key); localStorage.setItem(key, val); } catch (e) {}
      return null;
    }
    // Random id for this form only, so the rules can limit repeat sends. Not linked to anything else.
    var iid = store(IID_KEY);
    if (!iid || !/^[A-Za-z0-9_-]{22}$/.test(iid)) { iid = rnd(22, ALNUM + '-_'); store(IID_KEY, iid); }

    function picked(name) {
      var el = form.querySelector('input[name="' + name + '"]:checked');
      return el ? el.value : '';
    }
    function say(text, withMail) {
      status.textContent = text;
      if (withMail) {
        var a = document.createElement('a');
        a.href = 'mailto:' + TEXT.email;
        a.textContent = TEXT.email;
        status.appendChild(document.createTextNode(' '));
        status.appendChild(a);
      }
    }
    function showDone() {
      form.hidden = true;
      done.hidden = false;
      done.focus();
    }

    form.addEventListener('change', function (e) {
      if (e.target.name !== 'platform') return;
      var list = STEPS[e.target.value];
      stepsBox.querySelectorAll('.help-opt').forEach(function (opt) {
        var show = !list || list.split(' ').indexOf(opt.getAttribute('data-step')) !== -1;
        opt.hidden = !show;
        if (!show) opt.querySelector('input').checked = false;
      });
      stepsBox.hidden = false;
    });
    msg.addEventListener('input', function () { count.textContent = msg.value.length + '/500'; });

    function body(platform, step) {
      var s = function (v) { return { stringValue: v }; };
      return JSON.stringify({ writes: [
        { update: { name: DOCS + 'help_rate/' + iid, fields: {} },
          updateTransforms: [{ fieldPath: 'last', setToServerValue: 'REQUEST_TIME' }] },
        { update: { name: DOCS + 'help_requests/' + rnd(20, ALNUM), fields: {
            source: s('site'), platform: s(platform), step: s(step),
            message: s(msg.value.slice(0, 500)), email: s(email.value.trim()),
            lang: s(form.getAttribute('data-lang')), iid: s(iid), hp: s(''),
            expireAt: { timestampValue: new Date(Date.now() + 90 * 864e5).toISOString() },
            diag: { mapValue: { fields: { page: s(form.getAttribute('data-page')) } } }
          } },
          currentDocument: { exists: false },
          updateTransforms: [{ fieldPath: 'createdAt', setToServerValue: 'REQUEST_TIME' }] }
      ] });
    }

    function send(payload, attempt, lostOne) {
      return fetch(ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload })
        .then(function (r) {
          if (r.status >= 500 || r.status === 429) throw new Error('retry');
          // A 403 right after a lost response means the first try got through.
          return r.status === 200 || (r.status === 403 && lostOne) ? 'ok' : r.status === 403 ? 'denied' : 'error';
        })
        .catch(function () {
          if (attempt >= 3) return 'error';
          return new Promise(function (res) { setTimeout(res, 1000 * Math.pow(2, attempt)); })
            .then(function () { return send(payload, attempt + 1, true); });
        });
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (btn.disabled) return;
      var platform = picked('platform'), step = picked('step');
      if (!platform || !step) { say(TEXT.choose); return; }
      var mail = email.value.trim();
      if (mail && (mail.length > 120 || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail))) { say(TEXT.emailBad); email.focus(); return; }
      // Bots fill the hidden field: pretend it worked and send nothing.
      if (trap.value) { showDone(); return; }
      btn.disabled = true;
      btn.textContent = btn.getAttribute('data-sending');
      say('');
      send(body(platform, step), 0, false).then(function (result) {
        btn.disabled = false;
        btn.textContent = label;
        if (result === 'ok') { store(SENT_KEY, String(Date.now())); showDone(); return; }
        var last = Number(store(SENT_KEY)) || 0;
        if (result === 'denied' && Date.now() - last < FIVE_MIN) say(TEXT.recent);
        else say(TEXT.error, true);
      });
    });
  }());
</script>
