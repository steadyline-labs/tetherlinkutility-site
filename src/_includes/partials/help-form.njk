{#- "Can't connect?" help request form (anchor #help). Text comes from i18n[lang].help.
    Sent to Formspree (our service provider, delivers to the support inbox). With JavaScript the
    page posts JSON through deliverHelpRequest(); without it the plain form posts to the same URL.
    helpEndpoint is the only place the Formspree URL lives (FORM_ID_PENDING until the form exists).
    One send per browser every 5 minutes is checked in the page.
    Set helpPage ("guide" or "support") before including; it is sent as "page". -#}
{%- set helpEndpoint = "https://formspree.io/f/FORM_ID_PENDING" -%}
{%- set hp = t.help -%}
{%- set stepsFor = {
  "android": "start_sharing scan_qr join_wifi no_internet other",
  "ios": "start_sharing install join_wifi ios_proxy_app no_internet other",
  "windows": "start_sharing install join_wifi set_proxy no_internet other",
  "mac": "start_sharing install join_wifi set_proxy no_internet other",
  "linux": "start_sharing install join_wifi set_proxy no_internet other"
} -%}
  <section class="section wrap help" id="help">
    <div class="help-wrap">
      <div class="help-head">
        <h2>{{ hp.title }}</h2>
        <p class="help-intro">{{ hp.intro }}</p>
      </div>
      <form class="help-form" id="helpForm" action="{{ helpEndpoint }}" method="POST" accept-charset="UTF-8" data-lang="{{ lang }}" data-page="{{ helpPage or 'guide' }}">
        <input type="hidden" name="source" value="site">
        <input type="hidden" name="lang" value="{{ lang }}">
        <input type="hidden" name="page" value="{{ helpPage or 'guide' }}">
        <input type="hidden" name="_subject" value="TLU help (site)">
        <fieldset class="help-group" id="helpPlatforms">
          <legend>{{ hp.q1 }}</legend>
          <div class="help-opts">
{% for key, label in hp.platforms %}            <label class="help-opt"><input type="radio" name="platform" value="{{ key }}"{% if loop.first %} required{% endif %}><span>{{ label }}</span></label>
{% endfor %}          </div>
        </fieldset>
        <fieldset class="help-group" id="helpSteps">
          <legend>{{ hp.q2 }}</legend>
          <div class="help-opts">
{% for key, label in hp.steps %}            <label class="help-opt" data-step="{{ key }}"><input type="radio" name="step" value="{{ key }}"{% if loop.first %} required{% endif %}><span>{{ label }}</span></label>
{% endfor %}          </div>
        </fieldset>
        <div class="help-field">
          <label for="helpMessage">{{ hp.message }}</label>
          <textarea id="helpMessage" name="message" rows="4" maxlength="500" aria-describedby="helpCount"></textarea>
          <span class="help-count" id="helpCount">0/500</span>
        </div>
        <div class="help-field">
          <label for="helpEmail">{{ hp.email }}</label>
          <input id="helpEmail" name="email" type="email" maxlength="120" autocomplete="email" inputmode="email" spellcheck="false">
        </div>
        <div class="help-hp" aria-hidden="true">
          <label for="helpGotcha">Leave this empty</label>
          <input id="helpGotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
        </div>
        <button type="submit" class="btn-primary help-send" id="helpSend" data-sending="{{ hp.sending }}">{{ hp.button }}</button>
        <p class="help-status" id="helpStatus" role="status" aria-live="polite"></p>
        <p class="help-note">{{ hp.note }} <a href="{{ hp.privacyHref }}">{{ hp.privacyLink }}</a></p>
      </form>
      <div class="help-done" id="helpDone" hidden tabindex="-1">
        <p>{{ hp.success }}</p>
      </div>
    </div>
  </section>
<script>
  (function () {
    var form = document.getElementById('helpForm');
    if (!form) return;
    const HELP_ENDPOINT = {{ helpEndpoint | dump }};
    var STEPS = {{ stepsFor | dump }};
    var TEXT = {{ { recent: hp.recent, choose: hp.choose, emailBad: hp.emailBad, error: hp.error, email: site.email } | dump }};
    var SENT_KEY = 'tlu_help_sent', FIVE_MIN = 5 * 60 * 1000;

    function post(payload) {
      var ctrl = typeof AbortController === 'function' ? new AbortController() : null;
      var timer = setTimeout(function () { if (ctrl) ctrl.abort(); }, 10000);
      return fetch(HELP_ENDPOINT, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        signal: ctrl ? ctrl.signal : undefined
      }).then(function (r) { clearTimeout(timer); return r.status; },
              function () { clearTimeout(timer); return 0; });
    }

    // Sends one help request. Returns 'sent', 'too_soon' or 'failed'.
    // One retry on a network error (or timeout) or a 5xx answer.
    async function deliverHelpRequest(payload) {
      if (HELP_ENDPOINT.indexOf('FORM_ID_PENDING') !== -1) return 'failed';
      var status = await post(payload);
      if (status === 0 || status >= 500) {
        await new Promise(function (res) { setTimeout(res, 1500); });
        status = await post(payload);
      }
      if (status >= 200 && status < 300) return 'sent';
      if (status === 429) return 'too_soon';
      return 'failed';
    }

    var stepsBox = document.getElementById('helpSteps');
    var msg = document.getElementById('helpMessage');
    var count = document.getElementById('helpCount');
    var email = document.getElementById('helpEmail');
    var trap = document.getElementById('helpGotcha');
    var btn = document.getElementById('helpSend');
    var status = document.getElementById('helpStatus');
    var done = document.getElementById('helpDone');
    var label = btn.textContent;

    // With JavaScript the page checks the fields itself and shows the steps after a platform is picked.
    form.noValidate = true;
    stepsBox.hidden = true;

    function store(key, val) {
      try { if (val === undefined) return localStorage.getItem(key); localStorage.setItem(key, val); } catch (e) {}
      return null;
    }
    function sentRecently() {
      var last = Number(store(SENT_KEY)) || 0;
      return Date.now() - last < FIVE_MIN;
    }
    function picked(name) {
      var el = form.querySelector('input[name="' + name + '"]:checked');
      return el ? el.value : '';
    }
    function say(text, withMail) {
      status.textContent = text;
      if (withMail) {
        var a = document.createElement('a');
        a.href = 'mailto:' + TEXT.email;
        a.textContent = TEXT.email;
        status.appendChild(document.createTextNode(' '));
        status.appendChild(a);
      }
    }
    function showDone() {
      form.hidden = true;
      done.hidden = false;
      done.focus();
    }

    form.addEventListener('change', function (e) {
      if (e.target.name !== 'platform') return;
      var list = STEPS[e.target.value];
      stepsBox.querySelectorAll('.help-opt').forEach(function (opt) {
        var show = !list || list.split(' ').indexOf(opt.getAttribute('data-step')) !== -1;
        opt.hidden = !show;
        if (!show) opt.querySelector('input').checked = false;
      });
      stepsBox.hidden = false;
    });
    msg.addEventListener('input', function () { count.textContent = msg.value.length + '/500'; });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (btn.disabled) return;
      var platform = picked('platform'), step = picked('step');
      if (!platform || !step) { say(TEXT.choose); return; }
      var mail = email.value.trim();
      if (mail && (mail.length > 120 || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail))) { say(TEXT.emailBad); email.focus(); return; }
      // Bots fill the hidden field: pretend it worked and send nothing.
      if (trap.value) { showDone(); return; }
      if (sentRecently()) { say(TEXT.recent); return; }
      btn.disabled = true;
      btn.textContent = btn.getAttribute('data-sending');
      say('');
      var payload = {
        source: 'site', platform: platform, step: step, message: msg.value.slice(0, 500), email: mail,
        lang: form.getAttribute('data-lang'), page: form.getAttribute('data-page'),
        _subject: 'TLU help (site): ' + platform + ' / ' + step
      };
      if (mail) payload._replyto = mail;
      deliverHelpRequest(payload).catch(function () { return 'failed'; }).then(function (result) {
        btn.disabled = false;
        btn.textContent = label;
        if (result === 'sent') { store(SENT_KEY, String(Date.now())); showDone(); return; }
        if (result === 'too_soon') say(TEXT.recent);
        else say(TEXT.error, true);
      });
    });
  }());
</script>
