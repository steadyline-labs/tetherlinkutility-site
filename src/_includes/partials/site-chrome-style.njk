{#- Shared site chrome CSS (tokens, header, language menu, mobile drawer, navy footer).
    Included inside the <style> of the home, blog and privacy pages. -#}
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* Light warm theme. Brand orange (--accent) is for fills, large text and icons;
       small orange/green text uses the darker --accent-text / --success-text (AA on light). */
    :root {
      color-scheme: light;
      --ground:    #FBF6F0;
      --peach:     #FFF0E4;
      --surface:   #FFFFFF;
      --elevated:  #FFF5EC;
      --border:    #EFE3D6;
      --border-md: #E3D3C2;
      --accent:    #E8622A;
      --accent-text: #B4441A;
      --accent-soft: rgba(232,98,42,0.10);
      /* Button fill: darker orange so white labels pass 4.5:1 (#E8622A stays for highlights). */
      --accent-btn: #C4501F;
      --accent-btn-hover: #A9431A;
      --success:   #00BF8A;
      --success-text: #00775A;
      --success-bg: #E3F7EF;
      --text:      #1A1A2E;
      --muted:     #55536B;
      --dim:       #6A6780;
      --navy:      #0C0C18;
      --shadow-sm: 0 1px 2px rgba(60,35,15,0.05), 0 4px 14px -6px rgba(60,35,15,0.10);
      --shadow-lg: 0 2px 6px rgba(60,35,15,0.05), 0 24px 50px -18px rgba(90,45,15,0.25);
    }
    /* Navy band (Platforms) and footer reuse the original dark palette. */
    .band-navy, footer {
      --surface:   #141428;
      --elevated:  #1E1E38;
      --border:    #24243F;
      --border-md: #30305A;
      --text:      #ECEDFF;
      --muted:     #A3A3C7;
      --dim:       #9090B6;
      --accent-text: #F07A45;
      --success-text: #00BF8A;
      color: var(--text);
      /* The border image paints the full-width band; the same background colour under it changes
         nothing on screen but lets contrast checkers (axe) see the real background. */
      background-color: var(--navy);
      border-image: conic-gradient(var(--navy) 0 0) fill 0 / / 0 100vmax;
    }
    .band-peach { background-color: var(--peach); border-image: conic-gradient(var(--peach) 0 0) fill 0 / / 0 100vmax; }

    html { scroll-behavior: smooth; }
    [id] { scroll-margin-top: 80px; }

    body {
      background: var(--ground);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, system-ui, sans-serif;
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a { color: var(--accent-text); text-decoration: none; }
    a:hover { text-decoration: underline; }
    a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }

    .nowrap { white-space: nowrap; }
    .wrap { max-width: 1200px; margin: 0 auto; padding-left: clamp(20px, 5vw, 80px); padding-right: clamp(20px, 5vw, 80px); }

    /* ── Nav ─────────────────────────────── */
    nav {
      position: sticky; top: 0; z-index: 10;
      background: rgba(251,246,240,0.88);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      padding: 0 clamp(20px, 5vw, 80px);
      display: flex; align-items: center; justify-content: space-between;
      height: 64px;
    }
    .nav-brand {
      font-weight: 700; font-size: 15px; letter-spacing: 0.02em;
      color: var(--text); display: flex; align-items: center; gap: 10px;
    }
    .nav-brand:hover { text-decoration: none; }
    .nav-links { display: flex; gap: 26px; align-items: center; }
    .nav-links a { color: var(--muted); font-size: 14px; }
    .nav-links a:hover { color: var(--text); text-decoration: none; }
    .nav-links a.btn-nav {
      background: var(--accent-btn); color: #fff; font-size: 14px; font-weight: 700;
      padding: 9px 16px; border-radius: 9px; transition: background-color 0.15s;
    }
    .nav-links a.btn-nav:hover { background: var(--accent-btn-hover); color: #fff; }

    .lang-dropdown { position: relative; }
    .lang-dropdown-toggle {
      display: flex; align-items: center; gap: 6px;
      background: none; border: none; cursor: pointer;
      color: var(--muted); font-size: 14px; font-weight: 600; font-family: inherit; padding: 4px 0;
    }
    .lang-dropdown-toggle:hover { color: var(--text); }
    .lang-dropdown-toggle svg { transition: transform 0.2s ease; }
    .lang-dropdown.is-open .lang-dropdown-toggle svg { transform: rotate(180deg); }
    .lang-dropdown-menu {
      position: absolute; top: calc(100% + 14px); right: 0;
      background: var(--surface); border: 1px solid var(--border-md); border-radius: 10px;
      padding: 6px; min-width: 140px;
      display: none; flex-direction: column;
      box-shadow: var(--shadow-lg);
      z-index: 20;
    }
    .lang-dropdown.is-open .lang-dropdown-menu { display: flex; }
    .lang-dropdown-menu a {
      padding: 8px 12px; border-radius: 6px; font-size: 14px; color: var(--muted);
      white-space: nowrap;
    }
    .lang-dropdown-menu a:hover { background: var(--elevated); color: var(--text); text-decoration: none; }
    .lang-dropdown-menu a.is-current { color: var(--accent-text); font-weight: 600; }

    .nav-toggle {
      display: none; background: none; border: none; color: var(--text);
      width: 44px; height: 44px; padding: 0; cursor: pointer;
      align-items: center; justify-content: center;
    }
    .nav-toggle svg { display: block; }

    /* ── Footer ── two rows, each with a left and a right cluster pinned to the container ends ── */
    footer { padding-top: 40px; padding-bottom: 40px; color: var(--dim); }
    footer a { color: var(--muted); }
    footer a.footer-accent, footer .footer-brand a { color: var(--accent-text); }
    footer a:hover { color: var(--text); text-decoration: underline; }
    footer a:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; border-radius: 2px; }
    .footer-row { display: flex; justify-content: space-between; align-items: center; gap: 32px; }
    .footer-row a, .footer-row span { white-space: nowrap; }
    .footer-cluster, .footer-links, .footer-langs, .footer-brand { display: flex; align-items: center; }
    .footer-top { font-size: 14px; line-height: 20px; margin-bottom: 20px; }
    .footer-bottom { font-size: 13px; line-height: 20px; padding-top: 20px; border-top: 1px solid var(--border); }
    .footer-contact { gap: 24px; }
    .footer-wa { display: inline-flex; align-items: center; }
    .footer-wa .wa-icon { width: 16px; height: 16px; margin-right: 6px; flex-shrink: 0; }
    .footer-x { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; margin: -6px -8px -6px -4px; }
    .footer-brand { gap: 6px; }
    .footer-right { gap: 32px; }
    .footer-links { gap: 24px; }
    .footer-langs { gap: 16px; }
    .footer-langs .is-current { color: var(--text); font-weight: 600; }
    @media (max-width: 1023px) {
      footer.wrap { padding-top: 32px; padding-bottom: 32px; padding-left: 24px; padding-right: 24px; }
      .footer-row { gap: 24px; }
      .footer-top { font-size: 13px; margin-bottom: 16px; }
      .footer-bottom { font-size: 12px; line-height: 18px; padding-top: 16px; }
      .footer-contact, .footer-links { gap: 16px; }
      .footer-right { gap: 24px; }
      .footer-langs { gap: 12px; }
    }
    /* Phone: one left-aligned stack in reading order; Blog, Privacy and X share a line. */
    @media (max-width: 767px) {
      footer.wrap { display: flex; flex-wrap: wrap; align-items: center; column-gap: 20px; padding: 32px 20px 28px; }
      .footer-row, .footer-cluster, .footer-links { display: contents; }
      .footer-lead, .footer-email, .footer-wa { order: 1; flex: 0 0 100%; min-height: 44px; display: flex; align-items: center; font-size: 15px; line-height: 22px; }
      .footer-email { order: 2; } .footer-wa { order: 3; }
      .footer-links a { order: 4; display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; }
      .footer-x { order: 5; width: 44px; height: 44px; margin: 0 0 0 -12px; }
      .footer-right { display: contents; }
      .footer-langs { order: 6; flex: 0 0 100%; display: grid; grid-template-columns: repeat(3, auto); justify-content: start; column-gap: 16px; font-size: 14px; }
      .footer-langs a, .footer-langs span { display: flex; align-items: center; min-height: 44px; }
      .footer-bottom { display: contents; }
      .footer-brand { order: 7; flex: 0 0 100%; flex-wrap: wrap; column-gap: 6px; margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border); font-size: 13px; line-height: 20px; }
    }

    @media (max-width: 860px) {
      /* backdrop-filter on <nav> makes it a containing block for fixed-position
         descendants, which breaks the drawer's fixed positioning. Drop the blur on mobile. */
      nav { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(251,246,240,0.98); }

      .nav-toggle { display: flex; }
      .nav-links {
        position: fixed; top: 64px; right: 0; bottom: 0; width: min(75vw, 290px);
        background: var(--surface); border-left: 1px solid var(--border); box-shadow: var(--shadow-lg);
        flex-direction: column; align-items: flex-start; gap: 4px;
        padding: 20px; z-index: 9;
        clip-path: inset(0 0 0 100%); visibility: hidden; transition: clip-path 0.25s ease, visibility 0s linear 0.25s;
      }
      .nav-links.is-open { clip-path: inset(0); visibility: visible; transition: clip-path 0.25s ease; }
      .nav-links a { padding: 12px 4px; width: 100%; }
      .nav-links a.btn-nav { width: auto; padding: 12px 18px; margin-top: 12px; }
      .lang-dropdown { padding: 8px 4px; width: 100%; }
      .lang-dropdown-toggle { min-height: 44px; }
      /* Inside the drawer the list opens in the flow: an absolutely positioned menu would stick out of the
         drawer's left edge and be clipped by it. */
      .lang-dropdown-menu { position: static; min-width: 0; width: 100%; margin-top: 4px; box-shadow: none; background: var(--elevated); border-color: var(--border); }
      .lang-dropdown-menu a { display: flex; align-items: center; min-height: 44px; padding: 8px 12px; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
      html { scroll-behavior: auto; }
    }
