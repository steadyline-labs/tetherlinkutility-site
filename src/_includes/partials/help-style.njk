{#- Styles for the /help page (src/help.njk) and its contact block (partials/help-contact.njk).
    Included inside the <style> block after site-chrome-style.njk and read-base-style.njk. -#}
    .help-intro { color: var(--muted); margin-bottom: 28px; }
    .help-contact { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
    main .help-wa {
      display: inline-flex; align-items: center; min-height: 48px; text-decoration: none;
      font-weight: 700; font-size: 16px; background: var(--accent-btn); color: #fff; padding: 13px 32px; border-radius: 12px;
      box-shadow: 0 6px 16px -6px rgba(196,80,31,0.6); transition: background-color 0.15s;
    }
    main .help-wa:hover { background: var(--accent-btn-hover); text-decoration: none; }
    .help-wa:focus-visible { outline: 2px solid var(--accent-btn); outline-offset: 2px; }
    main .help-email { font-size: 16px; margin-bottom: 0; overflow-wrap: anywhere; }
    main .help-note { font-size: 13px; line-height: 1.6; color: var(--dim); margin-bottom: 0; }
