<script>
  (function () {
    // Click-to-play YouTube facade: the page shows a local poster image and loads nothing from
    // YouTube until the visitor clicks. The player then comes from youtube-nocookie.com.
    // Markup: .video-facade[data-yt-id][data-yt-title] (home demo, guide videos).
    document.querySelectorAll('.video-facade[data-yt-id]').forEach(function (el) {
      function play() {
        var id = el.getAttribute('data-yt-id');
        var iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&playsinline=1&rel=0';
        iframe.setAttribute('title', el.getAttribute('data-yt-title') || '');
        iframe.setAttribute('allow', 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        iframe.style.cssText = 'width:100%;height:100%;display:block;border:0;';
        el.replaceChildren(iframe);
        el.removeAttribute('role');
        el.removeAttribute('tabindex');
        el.removeAttribute('aria-label');
      }
      el.addEventListener('click', play, { once: true });
      el.addEventListener('keydown', function (e) {
        if (el.querySelector('iframe')) return;
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); play(); }
      });
    });
  }());
</script>
