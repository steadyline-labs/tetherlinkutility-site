{%- set t = i18n[lang] -%}
{%- set blogPrefix = t.prefix if (collections | hasBlog(lang)) else i18n[t.blogLang or "en"].prefix -%}
{%- set navMode = "blog" -%}
{%- set pageUrl = site.url + t.prefix + "blog/" -%}
{%- set blogTitle = t.blogTitle or (t.blog + ": Tether Link Utility") -%}
<!DOCTYPE html>
<html lang="{{ t.hreflang or lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="canonical" href="{{ pageUrl }}" />
{%- set ownBlog = collections | hasBlog(lang) %}
{% if ownBlog %}{% for l in site.languages %}{% if collections | hasBlog(l) %}  <link rel="alternate" hreflang="{{ i18n[l].hreflang or l }}" href="{{ site.url }}{{ i18n[l].prefix }}blog/" />
{% endif %}{% endfor %}  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/blog/" />
{% endif %}  <title>{{ blogTitle }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="{% if ownBlog %}index, follow{% else %}noindex, follow{% endif %}">

  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/favicon.png">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ blogTitle }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:site_name" content="Tether Link Utility">
  <meta property="og:locale" content="{{ t.ogLocale }}">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@{{ site.twitter }}">
  <meta name="twitter:title" content="{{ blogTitle }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ site.url }}/og-image.png">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Tether Link Utility Blog",
    "url": "{{ pageUrl }}",
    "publisher": { "@type": "Organization", "name": "Tether Link Utility" },
    "blogPost": [
{% for post in collections["posts_" + lang] | byPublished %}      {
        "@type": "BlogPosting",
        "headline": {{ (post.data.index.ldHeadline or post.data.index.title or post.data.title) | ldText }},
        "url": "{{ site.url }}{{ post.url }}",
        "datePublished": "{{ post.data.index.published or post.data.published }}"
      }{% if not loop.last %},{% endif %}
{% endfor %}    ]
  }
  </script>

{% include "partials/blog-index-style.njk" %}
</head>
<body>

{% set langPath = "blog/" %}{% include "partials/site-nav.njk" %}

<main>
  <div class="page-eyebrow">{{ eyebrow }}</div>
  <h1>{{ t.blog }}</h1>
{% for post in collections["posts_" + lang] | byPublished %}
  <a class="post-card" href="{{ post.url }}">
    <div class="post-date">{{ post.data.index.displayDate or ((post.data.index.published or post.data.published) | displayDate(lang)) }}</div>
    <div class="post-title">{{ post.data.index.title or post.data.title }}</div>
    <div class="post-excerpt">{{ post.data.index.excerpt or post.data.description }}</div>
  </a>
{% else %}  <p class="post-excerpt">{{ t.blogEmpty }} <a href="/blog/">{{ t.blogEmptyLink }}</a></p>
{% endfor %}</main>

{% include "partials/site-footer.njk" %}

{% include "partials/site-nav-script.njk" %}
</body>
</html>
