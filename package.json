{
  "name": "tetherlinkutility-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "compare": "node scripts/compare.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "eleventy --quiet && node --test --test-timeout=60000 \"tests/*.test.mjs\"",
    "test:ci": "eleventy --quiet && node --test --test-timeout=60000 $(ls tests/*.test.mjs | grep -v '[.]browser[.]')"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6"
  }
}
